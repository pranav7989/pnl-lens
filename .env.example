# ---- docker compose secrets (put these in .env, which is git-ignored) ----
# Generate each with 32+ random hex chars, e.g. PowerShell:
#   -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })   or   openssl rand -hex 32
POSTGRES_USER=lens_admin
POSTGRES_PASSWORD=
LENS_APP_PASSWORD=

# ---- Mode switches (work locally with zero accounts) ----
# dev | jwt   (jwt once phase 3 is done)
AUTH_MODE=dev
# file | pg
STORE_DRIVER=file
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_COUNTRY=IN
DEV_STARTING_CREDITS=5
REPORT_TTL_DAYS=30

# ---- Database: Amazon RDS for PostgreSQL (or any Postgres) ----
# App connects as the least-privilege lens_app role; migrations use the master user.
DATABASE_URL=
MIGRATE_DATABASE_URL=
# RDS: set to require; the Docker image bundles the RDS CA at /app/rds-ca.pem
DATABASE_SSL=
DATABASE_CA_PATH=
DATABASE_POOL_MAX=10

# ---- Sign-in: email code + Google ----
# Public URL of the site (used for OAuth redirects behind the load balancer)
APP_URL=
# 32+ random chars each
SESSION_SECRET=
OTP_PEPPER=
# ses (AWS) | resend | console (local: writes .data/dev-mail.log)
MAIL_DRIVER=console
MAIL_FROM=PnL Lens <no-reply@yourdomain.com>
SES_REGION=ap-south-1
RESEND_API_KEY=
# Google Cloud Console → OAuth client (Web). Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Payments (phase 5) ----
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PRICE_INR_MINOR=49900
PRICE_USD_MINOR=1900
# Price shown when the visitor's country can't be detected (no CloudFront header)
PRICING_DEFAULT_COUNTRY=US

# ---- Ops (phase 7) ----
# Only needed if you use the HTTP purge endpoint instead of the ECS scheduled task
CRON_SECRET=

# ---- Payments (docs/PAYMENTS_RAZORPAY.md) ----
# off (default) | link | razorpay
PAYMENTS_MODE=off
# link mode: paste Razorpay Payment Page / Link URLs
PAYMENT_LINK_SINGLE_INR=
PAYMENT_LINK_SINGLE_USD=
PAYMENT_LINK_SNAPSHOT_INR=
PAYMENT_LINK_SNAPSHOT_USD=
PAYMENT_LINK_PROGRESS_INR=
PAYMENT_LINK_PROGRESS_USD=
PAYMENT_LINK_DISCIPLINE_INR=
PAYMENT_LINK_DISCIPLINE_USD=
# razorpay mode
RAZORPAY_WEBHOOK_SECRET=
