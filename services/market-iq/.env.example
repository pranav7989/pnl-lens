# Copy to .env and fill in yourself. Never paste these values into a chat. .env is git-ignored.
# Dhan client ID (an account number, not a password)
DHAN_CLIENT_ID=
# 6-digit Dhan PIN and the TOTP secret from Dhan Web -> DhanHQ APIs -> Set up TOTP (the text under the QR code)
DHAN_PIN=
DHAN_TOTP_SECRET=
# Optional: API key and secret (only needed for the browser consent login; daily renewal uses PIN + TOTP)
DHAN_API_KEY=
DHAN_API_SECRET=
# Login for the dashboard itself (Phase 7)
APP_USERNAME=
APP_PASSWORD=
