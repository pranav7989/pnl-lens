  "rules": [
   {
    "rule": "Stop futures and stock positions at −8% of position value",
    "why": "Worth roughly ₹33,714 on the same trades."
   },
   {
    "rule": "Cap any single loss at ₹2,700",
    "why": "One average win. Work the quantity backwards from this number, not from available margin."
   },
   {
    "rule": "Exit a loser in one order",
    "why": "Partial exits on losing positions consistently cost more than the first exit would have."
   },
   {
    "rule": "Flat or converted 20 minutes before the close",
    "why": "Removes auto square-off fees and the exit price that comes with them."
   },
   {
    "rule": "Skip any setup with a target under 1.0%",
    "why": "Round-trip costs run about 0.12%; anything thinner works for the broker, not you."
   },
   {
    "rule": "Write entry, stop and target before the order goes in",
    "why": "Every leak above traces back to an exit that was never decided in advance."
   }
