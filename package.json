{
  "name": "pnl-lens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/engine",
    "packages/shared",
    "packages/db",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @pnl-lens/web",
    "build": "npm run build -w @pnl-lens/web",
    "start": "npm run start -w @pnl-lens/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "db:migrate": "npm run migrate -w @pnl-lens/db",
    "db:purge": "npm run purge -w @pnl-lens/db",
    "test:db": "npm run test:db -w @pnl-lens/web",
    "docs:index": "node scripts/gen-index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.70.1",
    "vitest": "^2.1.0"
  }
}
